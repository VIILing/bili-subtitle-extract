{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bili-subtitle-extract",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": ["23 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
